generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  POSTPONED
  BLOCKED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum WorkMode {
  SOLO
  TEAM
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  timezone     String         @default("America/Sao_Paulo")
  workMode     WorkMode       @default(SOLO)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  workdays     Workday[]
  routines     Routine[]
  tasks        Task[]
  checklists   Checklist[]
  weeklyReviews WeeklyReview[]
}

model Workday {
  id              String   @id @default(cuid())
  userId          String
  weekday         Int
  enabled         Boolean  @default(true)
  startMinutes    Int
  endMinutes      Int
  availableMinutes Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekday])
  @@index([userId, weekday])
}

model Routine {
  id                 String              @id @default(cuid())
  userId             String
  title              String
  description        String?
  category           String?
  frequency          RecurrenceFrequency
  weekdays           Int[]
  preferredStartMin  Int?
  estimatedMinutes   Int
  priority           TaskPriority        @default(MEDIUM)
  active             Boolean             @default(true)
  lastGeneratedAt    DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId, active])
}

model Checklist {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ChecklistItem[]
  tasks Task[]
}

model ChecklistItem {
  id          String   @id @default(cuid())
  checklistId String
  title       String
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
}

model Task {
  id                 String       @id @default(cuid())
  userId             String
  routineId          String?
  checklistId        String?
  title              String
  description        String?
  category           String?
  status             TaskStatus   @default(PENDING)
  priority           TaskPriority @default(MEDIUM)
  scheduledDate      DateTime?
  dueAt              DateTime?
  estimatedMinutes   Int
  actualMinutes      Int?
  preferredStartMin  Int?
  completedAt        DateTime?
  postponedUntil     DateTime?
  blockedReason      String?
  priorityScore      Float        @default(0)
  priorityReason     String?
  position           Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine   Routine?   @relation(fields: [routineId], references: [id], onDelete: SetNull)
  checklist Checklist? @relation(fields: [checklistId], references: [id], onDelete: SetNull)

  @@index([userId, scheduledDate])
  @@index([userId, status])
  @@index([userId, dueAt])
}

model WeeklyReview {
  id                    String   @id @default(cuid())
  userId                String
  weekStart              DateTime
  weekEnd                DateTime
  notes                 String?
  obstacles             String?
  nextWeekObjectives     String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
}